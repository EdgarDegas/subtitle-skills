{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "drop": {"type": "boolean"},
          "additions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {"type": "string", "enum": ["pun_note"]},
                "text": {"type": "string"}
              },
              "required": ["kind", "text"],
              "additionalProperties": false
            }
          },
          "skip_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["foreign text", "pun", "reveal order", "speaker label", "terminology"]
            }
          }
        },
        "required": ["id", "text", "drop", "additions", "skip_checks"],
        "additionalProperties": false
      }
    },
    "glossary_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {"type": "string"},
          "source": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "target": {"type": "string"},
          "notes": {"type": "string"},
          "cue_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}
        },
        "required": ["category", "source", "aliases", "target", "notes", "cue_ids"],
        "additionalProperties": false
      }
    }
  },
  "required": ["cues", "glossary_candidates"],
  "additionalProperties": false
}
